Program ::= WS* Assignment WS*

Assignment ::= AssignExpr WS* AssignOp WS* Expr WS* ";"

Expr ::= EqualsExpr

EqualsExpr          ::= UnaryExpr WS* "==" WS* Expr | UnequalsExpr
UnequalsExpr        ::= UnaryExpr WS* "!=" WS* Expr | GreatherEqualsExpr
GreatherEqualsExpr  ::= UnaryExpr WS* ">=" WS* Expr | GreatherExpr
GreatherExpr        ::= UnaryExpr WS* ">"  WS* Expr | LesserEqualsExpr
LesserEqualsExpr    ::= UnaryExpr WS* "<=" WS* Expr | LesserExpr
LesserExpr          ::= UnaryExpr WS* "<"  WS* Expr | AndExpr
AndExpr             ::= UnaryExpr WS* "&&" WS* Expr | OrExpr
OrExpr              ::= UnaryExpr WS* "||" WS* Expr | AddExpr
AddExpr             ::= UnaryExpr WS* "+"  WS* Expr | MultiplyExpr
MultiplyExpr        ::= UnaryExpr WS* "*"  WS* Expr | ExtractExpr
ExtractExpr         ::= UnaryExpr WS* "<@" WS* Expr | EmbedExpr
EmbedExpr           ::= UnaryExpr WS* ">@" WS* Expr | RangedExpr
RangedExpr          ::= UnaryExpr WS* "@"  WS* Expr | UnaryExpr
UnaryExpr           ::= (UnaryOp WS*)? IndexExpr
IndexExpr           ::= BracketExpr (WS* MultiIndexExpr)?
BracketExpr         ::= "(" WS* Expr WS* ")" | MultiIndexExpr
MultiIndexExpr      ::= "[" WS* MultiIndexExprArgs "]" | RValue
MultiIndexExprArgs  ::= Expr WS* ("," WS* MultiIndexExprArgs)?

AssignExpr          ::= AssignIndexExpr 
AssignIndexExpr     ::= Identifier (WS* MultiIndexExpr)?

AssignOp ::= BinaryOp? "="
BinaryOp ::= "+" | "-" | "*" | "&&" | "||" | "<@" | ">@" | "@"
UnaryOp  ::= "-" | "!" | "*"

Type ::= VectorialType | ImageType
VectorialType ::= FormatType | RANGE_TYPE | MULTI_TYPE
FormatType ::= RGBA_TYPE | RGB_TYPE | ScalarType
ScalarType ::= BOOLEAN_TYPE | INT_TYPE | FLOAT_TYPE | CHANNEL_TYPE
ImageType ::= "Image" WS* "(" WS* imageTypeArgs WS* ")"
imageTypeArgs ::= "**" | imageTypeArg WS* "," WS* imageTypeSizeArgs
imageTypeArg ::= FormatType | Identifier | "*"
imageTypeSizeArgs ::= "**" | imageTypeSizeArg (WS* "," WS* imageTypeSizeArgs)?
imageTypeSizeArg ::= RValue | "*"

string ::= '"' [^"]* '"'

Identifier ::= !KEYWORD [a-zA-Z] [a-zA-Z0-9]* WS*
LValue ::= RLValue
RValue ::= ScalarValue | VectorialType | RLValue
RLValue ::= Identifier
ScalarValue ::= BOOLEAN | INT | FLOAT
IndexableValue ::= !ScalarValue RValue

BOOLEAN ::= "false" | "true"
FLOAT ::= [+-]? [0-9]* [.]? [0-9]+ ([eE] [+-]? [0-9]+)?
INT ::= [+-]? UINT
UINT ::= [0-9]+

RGBA_TYPE ::= "RGBA" WS*
RGB_TYPE ::= "RGB" WS*
BOOLEAN_TYPE ::= "boolean" WS*
INT_TYPE ::= "int" WS*
FLOAT_TYPE ::= "float" WS*
CHANNEL_TYPE ::= "channel" WS*
RANGE_TYPE ::= "range" WS*
MULTI_TYPE ::= "multi" WS*

KEYWORD ::= "false" | "true" | VectorialType | "operation"
    | "void" | "return" | "if" | "else" | "for" | "break" | "continue"

IT ::= ![a-zA-Z0-9] ANY
WS ::= Comment | MultiLineComment | [#x20#x09#x0A#x0D]+
INLINE_WS ::= Comment | SingleLineComment | [#x20#x09]+

Comment ::= "//" (!EOL ANY)*
MultiLineComment ::= "/*" (!"*/" ANY)* "*/"
SingleLineComment ::= "/*" (!"*/" !EOL ANY)* "*/"

EOL ::= (!#x0D #x0A | #x0D #x0A) EOF? | EOF
ANY ::= [#x00-#xFFFF]
any0 ::= [#x00-#xFFFF]
