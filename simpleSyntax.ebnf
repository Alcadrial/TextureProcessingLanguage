
Program ::= Configs? Code? WS* EOF

Configs ::= WS* Config Configs?
Config ::= "#" ConfigName INLINE_WS* ConfigValue INLINE_WS* EOL
ConfigName ::= [a-zA-Z] [a-zA-Z0-9]*
ConfigValue ::= [a-zA-Z] [a-zA-Z0-9]* | [0-9]+

Code ::= WS* (Function | Operation | Command) Code?

Function ::= ReturnType WS+ Identifier WS* args WS* Body
Operation ::= "operation" WS+ Identifier WS* args WS* Body

args ::= "(" (arg WS* "," WS*)* arg WS* ")"
arg ::= Type WS+ Identifier

/*well formed*/

ReturnType ::= Type | "void"
Body ::= "{" Commands? WS* "}"
Commands ::= WS* Command Commands?

Command ::= ReturnCommand | Decl | Assignment | Call | ForLike | IfLike | Body

ReturnCommand ::= "return" (WS+ Expr)? WS* ";"
Decl ::= Type WS+ Identifier WS* ("=" WS* Expr WS*)? ";"
Assignment ::= AssignExpr AssignOp Expr WS* ";"
Call ::= "wip;"

ForLike ::= "for" WS* "(" WS* LoopVar WS* ":" WS* Iterable ")" WS* ForBody
ForBody ::= "{" ForCommands? WS* "}" | ForCommand
ForCommands ::= WS* ForCommand ForCommands?
ForCommand ::= Command | "break" WS* ";" | "continue" WS* ";"
LoopVar ::= Identifier | MultiIndexLoopVar
MultiIndexLoopVar ::= "[" WS* MultiIndexLoopVarArgs "]"
MultiIndexLoopVarArgs ::= Identifier WS* ("," WS* MultiIndexLoopVarArgs)?
Iterable ::= Expr

IfLike ::= "if" WS* "(" WS* Expr WS* ")" WS* Body (WS* ElseLike)?
ElseLike ::= "else" WS* Body

Expr ::= MultiIndexExpr

MultiIndexExpr ::= "[" WS* MultiIndexExprArgs "]" | EqualsExpr
MultiIndexExprArgs ::= Expr WS* ("," WS* MultiIndexExprArgs)?

EqualsExpr ::= UnequalsExpr WS* "==" WS* EqualsExpr | UnequalsExpr
UnequalsExpr ::= GreatherEqualsExpr WS* "!=" WS* UnequalsExpr | GreatherEqualsExpr
GreatherEqualsExpr ::= GreatherExpr WS* ">=" WS* GreatherEqualsExpr | GreatherExpr
GreatherExpr ::= LesserEqualsExpr WS* ">" WS* GreatherExpr | LesserEqualsExpr
LesserEqualsExpr ::= LesserExpr WS* "<=" WS* LesserEqualsExpr | LesserExpr
LesserExpr ::= AndExpr WS* "<" WS* LesserExpr | AndExpr
AndExpr ::= OrExpr WS* "&&" WS* AndExpr | OrExpr
OrExpr ::= AddExpr WS* "||" WS* OrExpr | AddExpr
AddExpr ::= MultiplyExpr WS* "+" WS* AddExpr | MultiplyExpr
MultiplyExpr ::= ExtractExpr WS* "*" WS* MultiplyExpr | ExtractExpr
ExtractExpr ::= EmbedExpr WS* "<@" WS* ExtractExpr | EmbedExpr
EmbedExpr ::= RangedExpr WS* ">@" WS* EmbedExpr | RangedExpr
RangedExpr ::= UnaryExpr WS* "@" WS* RangedExpr | UnaryExpr
UnaryExpr ::= (UnaryOp WS*)? IndexExpr
IndexExpr ::= RValue (WS* "[" WS* Expr WS* "]")?

AssignExpr ::= AssignIndexOrIdentityExpr
AssignIndexOrIdentityExpr ::= Identifier (WS* AssignIndexExpr)+ | Identifier
AssignIndexExpr ::= "[" WS* Expr WS* "]"

AssignOp ::= BinaryOp? "="
BinaryOp ::= "+" | "-" | "*" | "&&" | "||" | "<@" | ">@" | "@"
UnaryOp ::= "-" | "!" | "*"

Type ::= VectorialType | ImageType
VectorialType ::= FormatType | "range" | "multi"
FormatType ::= "RGBA" | "RGB" | ScalarType
ScalarType ::= "boolean" | "int" | "float" | "channel"
ImageType ::= "Image" WS* "(" WS* imageTypeArgs WS* ")"
imageTypeArgs ::= "**" | imageTypeArg WS* "," WS* imageTypeSizeArgs
imageTypeArg ::= FormatType | Identifier | "*"
imageTypeSizeArgs ::= "**" | imageTypeSizeArg (WS* "," WS* imageTypeSizeArgs)?
imageTypeSizeArg ::= RValue | "*"

string ::= '"' [^"]* '"'

Identifier ::= !KEYWORD [a-zA-Z] [a-zA-Z0-9]* WS*
LValue ::= RLValue
RValue ::= ScalarValue | VectorialType | RLValue
RLValue ::= Identifier
ScalarValue ::= BOOLEAN | INT | FLOAT
IndexableValue ::= !ScalarValue RValue

BOOLEAN ::= "false" | "true"
FLOAT ::= [+-]? [0-9]* ANY? [0-9]+ ([eE] [+-]? [0-9]+)?
INT ::= [+-]? UINT
UINT ::= [0-9]+

KEYWORD ::= "false" | "true" | VectorialType | "operation"
    | "void" | "return" | "if" | "else" | "for" | "break" | "continue"

IT ::= ![a-zA-Z0-9] ANY
WS ::= Comment | MultiLineComment | [#x20#x09#x0A#x0D]+
INLINE_WS ::= Comment | SingleLineComment | [#x20#x09]+

Comment ::= "//" (!EOL ANY)*
MultiLineComment ::= "/*" (!"*/" ANY)* "*/"
SingleLineComment ::= "/*" (!"*/" !EOL ANY)* "*/"

EOL ::= (!#x0D #x0A | #x0D #x0A) EOF? | EOF
ANY ::= [#x00-#xFFFF]
any0 ::= [#x00-#xFFFF]
