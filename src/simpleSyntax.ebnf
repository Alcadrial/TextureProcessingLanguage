
Program ::= (WS* Command)* WS* EOF | Expr EOF

Exec    ::= Closure | Command
Closure ::= "{" (WS* Command)* WS* "}"
Command ::= Nop | Signal | Print | ReturnCommand | Decl | Assignment | Call | WhileLike | IfLike | Closure | Function

Nop           ::= ";"
Signal        ::= "signal" WS* (String WS*)? ";"
Print         ::= "print" WS* String WS* (CallArgs WS*)? ";"
ReturnCommand ::= "return" WS+ Expr ";"
Decl          ::= DeclConst | DeclVar
DeclConst     ::= "const" WS+ Identifier "=" WS* Expr WS* ";"
DeclVar       ::= "var" WS+ Identifier ("=" WS* Expr)? ";"
Assignment    ::= Identifier RangedAssign? AssignOp WS* Expr ";"
RangedAssign  ::= "[" WS* Expr "," WS* Expr "->" WS* Expr "," WS* Expr ("," WS* Expr)? "]" WS*

Call          ::= Identifier CallArgs WS* ";"
CallArgs      ::= "(" WS* ((Expr "," WS*)* Expr)? ")"

WhileLike       ::= "while" WS* "(" WS* Expr ")" WS* LoopBody
LoopBody        ::= "{" (WS* LoopCommand)* WS* "}" | LoopCommand
LoopCommand     ::= Command | LoopFlowCommand WS* ";"
LoopFlowCommand ::= "break" | "continue"

IfLike ::= "if" WS* "(" WS* Expr ")" WS* Exec (WS* ElseLike)?
ElseLike ::= "else" WS* Exec

Function ::= Identifier FunctionArgs WS* Exec
FunctionArgs ::= "(" WS* ((Identifier "," WS*)* Identifier)? ")"

Expr ::= BinRotateExpr
/* add Formatting ~ ~? */
/* add ApplyTransform <~> */
BinRotateExpr     ::= UnaryExpr WS* RotateTypeOp WS* Expr | BinConcatExpr
BinConcatExpr     ::= UnaryExpr WS* ConcatOp WS* Expr | BinCompareExpr
BinCompareExpr    ::= UnaryExpr WS* CompareOp WS* Expr | BinAndExpr
BinAndExpr        ::= UnaryExpr WS* AndOp WS* Expr | BinOrExpr
BinOrExpr         ::= UnaryExpr WS* OrOp WS* Expr | BinAddSubExpr
BinAddSubExpr     ::= UnaryExpr WS* AddSubOp WS* Expr | BinMulDivRemExpr
BinMulDivRemExpr  ::= UnaryExpr WS* MulDivRemOp WS* Expr | BinBlendingExpr
BinBlendingExpr   ::= UnaryExpr WS* BlendOp WS* Expr | UnaryExpr
UnaryExpr         ::= (UnaryOp WS*)? RangeExpr
RangeExpr         ::= ResizeExpr ("[" WS* Expr "," WS* Expr "->" WS* Expr "," WS* Expr ("," WS* Expr)? "]" WS*)?
ResizeExpr        ::= CallExpr ("{" WS* Expr "," WS* Expr ("," WS* Expr)? "}" WS*)?
CallExpr          ::= Identifier CallArgs WS* | BracketExpr
BracketExpr       ::= "(" WS* Expr ")" WS* | ClosureExpr
ClosureExpr       ::= Closure WS* | Value

AssignOp ::= BinaryOp? "="
BinaryOp  ::= RotateTypeOp | ConcatOp | AndOp | OrOp | AddSubOp
    | BlendOp | MulDivRemOp

UnaryOp   ::= "|" | "#" | "-" | "!"

RotateTypeOp ::= "@"   | "!@"
ConcatOp     ::= "|<^" | "|<v" | "|>v" | "|>^" | "|<"  | "|>"  | "|v"  | "|^"
CompareOp    ::= "=="  | "!="  | ">="  | ">"   | "<="  | "<"
AndOp        ::= "&&"
OrOp         ::= "||"
AddSubOp     ::= "+"   | "-"
MulDivRemOp  ::= "*"   | "/"   | "%"
BlendOp      ::= "**"

Identifier ::= !KEYWORD [a-zA-Z] [a-zA-Z0-9]* WS*
Value ::= Identifier | String WS* | Boolean WS* | Float WS* | Int WS*

String ::= '"' [^"]* '"' | "'" [^']* "'"
Boolean ::= "false" | "true"
Float ::= [+-]? [0-9]* "."? [0-9]+ ([eE] [+-]? [0-9]+)?
Int ::= [+-]? UINT
UINT ::= [0-9]+

KEYWORD ::= "false" | "true" | "const" | "var" | "return" | "if" | "else" | "while" | "break" | "continue" | "signal" | "print"

WS ::= Comment | MultiLineComment | [#x20#x09#x0A#x0D]+

Comment ::= "//" (!EOL ANY)*
MultiLineComment ::= "/*" (!"*/" ANY)* "*/"
InlineComment ::= "/*" (!"*/" !EOL ANY)* "*/"

EOL ::= (!#x0D #x0A | #x0D #x0A) EOF? | EOF
ANY ::= [#x00-#xFFFF]
