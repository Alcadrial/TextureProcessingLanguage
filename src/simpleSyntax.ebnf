
Program ::= (WS* Command)* WS* EOF

Exec    ::= Closure | Command
Closure ::= "{" (WS* Command)* WS* "}"
Command ::= Nop | Signal | ReturnCommand | Decl | Assignment | Call | WhileLike | IfLike | Closure | Function

Nop           ::= ";"
Signal        ::= "signal" WS* (String WS*)? ";"
ReturnCommand ::= "return" WS+ Expr ";"
Decl          ::= DeclConst | DeclVar
DeclConst     ::= "const" WS+ Identifier "=" WS* String WS* ";"
DeclVar       ::= "var" WS+ Identifier ("=" WS* Expr)? ";"
Assignment    ::= Identifier AssignOp WS* Expr ";"

Call          ::= Identifier CallArgs WS* ";"
CallArgs      ::= "(" WS* ((Expr "," WS*)* Expr)? ")"

WhileLike     ::= "while" WS* "(" WS* Expr ")" WS* LoopBody
LoopBody      ::= "{" (WS* LoopCommand)* WS* "}" | LoopCommand
LoopCommand   ::= Command | "break" WS* ";" | "continue" WS* ";"

IfLike ::= "if" WS* "(" WS* Expr ")" WS* Exec (WS* ElseLike)?
ElseLike ::= "else" WS* Exec

Function ::= Identifier FunctionArgs WS* Exec
FunctionArgs ::= "(" WS* ((Identifier "," WS*)* Identifier)? ")"

Expr ::= BinConcatExpr
/* add Concats |< |> |v |^ |<^ |<v |>v |>^ */
/* add Rotate @ !@ */
/* add Reflect <|> <-> */
/* add Formatting ~ ~? */
/* add ApplyTransform ~<T> */
BinConcatExpr          ::= UnaryExpr WS* "|"  WS* Expr | BinEqualsExpr
BinEqualsExpr          ::= UnaryExpr WS* "==" WS* Expr | BinUnequalsExpr
BinUnequalsExpr        ::= UnaryExpr WS* "!=" WS* Expr | BinGreatherEqualsExpr
BinGreatherEqualsExpr  ::= UnaryExpr WS* ">=" WS* Expr | BinGreatherExpr
BinGreatherExpr        ::= UnaryExpr WS* ">"  WS* Expr | BinLesserEqualsExpr
BinLesserEqualsExpr    ::= UnaryExpr WS* "<=" WS* Expr | BinLesserExpr
BinLesserExpr          ::= UnaryExpr WS* "<"  WS* Expr | BinAndExpr
BinAndExpr             ::= UnaryExpr WS* "&&" WS* Expr | BinOrExpr
BinOrExpr              ::= UnaryExpr WS* "||" WS* Expr | BinAddExpr
BinAddExpr             ::= UnaryExpr WS* "+"  WS* Expr | BinSubtractExpr
BinSubtractExpr        ::= UnaryExpr WS* "-"  WS* Expr | BinMultiplyExpr
BinMultiplyExpr        ::= UnaryExpr WS* "*"  WS* Expr | BinDivideExpr
BinDivideExpr          ::= UnaryExpr WS* "/"  WS* Expr | BinRemainderExpr
BinRemainderExpr       ::= UnaryExpr WS* "%"  WS* Expr | BinExtractExpr
BinExtractExpr         ::= UnaryExpr WS* "<@" WS* Expr | BinEmbedExpr
BinEmbedExpr           ::= UnaryExpr WS* ">@" WS* Expr | BinRangedExpr
BinRangedExpr          ::= UnaryExpr WS* "@"  WS* Expr | BinBlendingExpr
BinBlendingExpr        ::= UnaryExpr WS* "**" WS* Expr | UnaryExpr
UnaryExpr              ::= (UnaryOp WS*)? CallExpr
CallExpr               ::= Identifier CallArgs WS* | BracketExpr
BracketExpr            ::= "(" WS* Expr ")" WS* | ClosureExpr
ClosureExpr            ::= Closure WS* | Value

AssignOp ::= BinaryOp? "="
BinaryOp ::= "+" | "-" | "*" | "**" | "&&" | "||" | "<@" | ">@" | "@"
UnaryOp  ::= "-" | "!"

Identifier ::= !KEYWORD [a-zA-Z] [a-zA-Z0-9]* WS*
Value ::= Identifier | String WS* | Boolean WS*

String ::= '"' [^"]* '"' | "'" [^']* "'"
Boolean ::= "false" | "true"
Int ::= [+-]? UINT
UINT ::= [0-9]+

KEYWORD ::= "false" | "true" | "const" | "var" | "return" | "if" | "else" | "while" | "break" | "continue" | "signal"

WS ::= Comment | MultiLineComment | [#x20#x09#x0A#x0D]+

Comment ::= "//" (!EOL ANY)*
MultiLineComment ::= "/*" (!"*/" ANY)* "*/"
InlineComment ::= "/*" (!"*/" !EOL ANY)* "*/"

EOL ::= (!#x0D #x0A | #x0D #x0A) EOF? | EOF
ANY ::= [#x00-#xFFFF]
