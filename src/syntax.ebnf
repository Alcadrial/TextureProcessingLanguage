
Program ::= Configs? Code? WS* EOF

Configs ::= WS* Config Configs?
Config ::= "#" ConfigName INLINE_WS* ConfigValue INLINE_WS* EOL
ConfigName ::= [a-zA-Z] [a-zA-Z0-9]*
ConfigValue ::= [a-zA-Z] [a-zA-Z0-9]* | [0-9]+

Code ::= WS* (Function | Command) Code?

Function ::= ReturnType WS+ Identifier WS* FunctionArgs WS* Closure

FunctionArgs ::= "(" (FunctionArg WS* "," WS*)* FunctionArg WS* ")"
FunctionArg ::= Type WS+ Identifier

ReturnType ::= Type | "void"
Closure ::= "{" Commands? WS* "}"
Body ::= Closure | Command
Commands ::= WS* Command Commands?

Command ::= ReturnCommand | Decl | Assignment | Call | ForLike | IfLike | Closure | Abort

ReturnCommand ::= "return" (WS+ Expr)? WS* ";"
Decl          ::= Type WS+ Identifier WS* ("=" WS* Expr WS*)? ";" | ImageType WS+ Identifier WS* "=" WS* "empty" WS* ";"
Assignment    ::= AssignExpr WS* AssignOp WS* Expr WS* ";"
Call          ::= Identifier WS* CallArgs WS* ";"
CallArgs      ::= "(" (CallArg WS* "," WS*)* CallArg WS* ")"
CallArg       ::= Expr

ForLike               ::= "for" WS* "(" WS* LoopVar WS* ":" WS* Iterable ")" WS* ForBody
ForBody               ::= "{" ForCommands? WS* "}" | ForCommand
ForCommands           ::= WS* ForCommand ForCommands?
ForCommand            ::= Command | "break" WS* ";" | "continue" WS* ";"
LoopVar               ::= Identifier | MultiIndexLoopVar
MultiIndexLoopVar     ::= "[" WS* MultiIndexLoopVarArgs "]"
MultiIndexLoopVarArgs ::= Identifier WS* ("," WS* MultiIndexLoopVarArgs)?
Iterable              ::= Expr

IfLike ::= "if" WS* "(" WS* Expr WS* ")" WS* Body (WS* ElseLike)?
ElseLike ::= "else" WS* Body

Abort ::= "abort" WS* ";"

Expr ::= ConcatExpr

ConcatExpr          ::= UnaryExpr WS* "|"  WS* Expr | EqualsExpr
EqualsExpr          ::= UnaryExpr WS* "==" WS* Expr | UnequalsExpr
UnequalsExpr        ::= UnaryExpr WS* "!=" WS* Expr | GreatherEqualsExpr
GreatherEqualsExpr  ::= UnaryExpr WS* ">=" WS* Expr | GreatherExpr
GreatherExpr        ::= UnaryExpr WS* ">"  WS* Expr | LesserEqualsExpr
LesserEqualsExpr    ::= UnaryExpr WS* "<=" WS* Expr | LesserExpr
LesserExpr          ::= UnaryExpr WS* "<"  WS* Expr | AndExpr
AndExpr             ::= UnaryExpr WS* "&&" WS* Expr | LogicalOrExpr
LogicalOrExpr       ::= UnaryExpr WS* "||" WS* Expr | AddExpr
AddExpr             ::= UnaryExpr WS* "+"  WS* Expr | SubtractExpr
SubtractExpr        ::= UnaryExpr WS* "-"  WS* Expr | MultiplyExpr
MultiplyExpr        ::= UnaryExpr WS* "*"  WS* Expr | DivideExpr
DivideExpr          ::= UnaryExpr WS* "/"  WS* Expr | RemainderExpr
RemainderExpr       ::= UnaryExpr WS* "%"  WS* Expr | ExtractExpr
ExtractExpr         ::= UnaryExpr WS* "<@" WS* Expr | EmbedExpr
EmbedExpr           ::= UnaryExpr WS* ">@" WS* Expr | RangedExpr
RangedExpr          ::= UnaryExpr WS* "@"  WS* Expr | UnaryExpr
UnaryExpr           ::= (UnaryOp WS*)? SwizzleExpr
SwizzleExpr         ::= IndexExpr Swizzle?
IndexExpr           ::= CallExpr (WS* MultiIndexExpr)?
CallExpr            ::= Identifier WS* CallArgs | RangeExpr
RangeExpr           ::= "[" WS* MultiIndexExprArgs "]" WS* "->" WS* "[" WS* MultiIndexExprArgs "]" | BracketExpr
BracketExpr         ::= "(" WS* Expr WS* ")" | MultiIndexExpr
MultiIndexExpr      ::= "[" WS* MultiIndexExprArgs "]" | Value
MultiIndexExprArgs  ::= Expr WS* ("," WS* MultiIndexExprArgs)?

AssignExpr          ::= AssignSwizzleExpr 
AssignSwizzleExpr   ::= AssignIndexExpr Swizzle?
AssignIndexExpr     ::= Identifier (WS* MultiIndexExpr)?

AssignOp ::= BinaryOp? "="
BinaryOp ::= "+" | "-" | "*" | "&&" | "||" | "<@" | ">@" | "@"
UnaryOp  ::= "-" | "!" | "*"

Swizzle  ::= "." Swizzle0?
Swizzle0 ::= [rgba] Swizzle1?
Swizzle1 ::= [rgba] Swizzle2?
Swizzle2 ::= [rgba] Swizzle3?
Swizzle3 ::= [rgba]

Type              ::= VectorialType | ImageType
VectorialType     ::= FormatType | "range" | "multi"
FormatType        ::= "RGBA" | "RGB" | ScalarType
ScalarType        ::= "boolean" | "int" | "float" | "channel"
ImageType         ::= "Image" (WS* "(" WS* ImageTypeArgs WS* ")")?
ImageTypeArgs     ::= "**" | ImageTypeArg WS* "," WS* ImageTypeSizeArgs
ImageTypeArg      ::= FormatType | Identifier | "*"
ImageTypeSizeArgs ::= "**" | ImageTypeSizeArg (WS* "," WS* ImageTypeSizeArgs)?
ImageTypeSizeArg  ::= Value | "*"

String ::= '"' [^"]* '"' | "'" [^']* "'"

Identifier ::= !KEYWORD [a-zA-Z] [a-zA-Z0-9]* WS*
Value ::= ScalarValue | Identifier | String
ScalarValue ::= Boolean | Int | Float

Boolean ::= "false" | "true"
Float ::= [+-]? [0-9]* "."? [0-9]+ ([eE] [+-]? [0-9]+)?
Int ::= [+-]? UINT
UINT ::= [0-9]+

KEYWORD ::= "false" | "true" | VectorialType | "abort"
    | "void" | "return" | "if" | "else" | "for" | "break" | "continue"

WS ::= Comment | MultiLineComment | [#x20#x09#x0A#x0D]+
INLINE_WS ::= Comment | InlineComment | [#x20#x09]+

Comment ::= "//" (!EOL ANY)*
MultiLineComment ::= "/*" (!"*/" ANY)* "*/"
InlineComment ::= "/*" (!"*/" !EOL ANY)* "*/"

EOL ::= (!#x0D #x0A | #x0D #x0A) EOF? | EOF
ANY ::= [#x00-#xFFFF]
